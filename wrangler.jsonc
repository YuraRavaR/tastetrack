// The top level is production: `wrangler deploy` without `--env` ships it, so
// TEST_HOOKS is absent here. Test hooks are switched on only in the `local` and
// `staging` envs below, and answer only requests with TEST_HOOKS_SECRET (ADR-0010): a placeholder
// in `local`, a `wrangler secret put` secret on staging. Envs don't inherit `vars` or bindings, so
// each env repeats the bindings it needs. TMDB_BASE_URL is real TMDB everywhere except `local`, which
// searches the TMDB fake among its own test hooks with a placeholder token. TMDB_ACCESS_TOKEN is
// a secret on staging and production, set with `wrangler secret put` (see README). Book search
// calls OPEN_LIBRARY_BASE_URL the same way: the real Open Library everywhere except `local`, which
// searches the Open Library fake. OPEN_LIBRARY_CONTACT, how Open Library can reach the Operator
// (ADR-0011), is each deployment's own and so a secret on staging and production too. Game search
// calls IGDB_BASE_URL with an access token from TWITCH_TOKEN_URL, both the real ones everywhere
// except `local`, which calls the IGDB fake for both with placeholder credentials; the Twitch
// application's TWITCH_CLIENT_ID and TWITCH_CLIENT_SECRET are secrets on staging and production
// (ADR-0012). Album search calls MUSICBRAINZ_BASE_URL, and album covers are linked from
// COVER_ART_ARCHIVE_BASE_URL, both the real ones everywhere except `local`, which calls their
// fakes and waits MUSICBRAINZ_INTERVAL_MS between calls instead of 1.1 s, which the fake holds it
// to; MusicBrainz takes no key, so albums have no secret (ADR-0013). The Worker
// runs first for the API and for Share Link pages (/s/*), whose <head> it fills in on the app's
// HTML from the ASSETS binding (ADR-0008); everything else is served as static assets. The Cron
// Trigger refreshes the catalog cache every 15 minutes (ADR-0004) and clears login failures that no
// longer count, in production only: envs inherit triggers, so `local` and `staging` clear them,
// which keeps staging's writes off the account's shared D1 budget (ADR-0006).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tastetrack",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "vars": {
    "TMDB_BASE_URL": "https://api.themoviedb.org/3",
    "OPEN_LIBRARY_BASE_URL": "https://openlibrary.org",
    "IGDB_BASE_URL": "https://api.igdb.com/v4",
    "TWITCH_TOKEN_URL": "https://id.twitch.tv/oauth2/token",
    "MUSICBRAINZ_BASE_URL": "https://musicbrainz.org/ws/2",
    "COVER_ART_ARCHIVE_BASE_URL": "https://coverartarchive.org"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tastetrack-production",
      "database_id": "dbbae3f8-e6a6-4053-afb4-2b7b327d5a93",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1",
        "TEST_HOOKS_SECRET": "local-test-hooks-secret",
        "TMDB_BASE_URL": "http://localhost:8787/api/test/tmdb/3",
        "TMDB_ACCESS_TOKEN": "fake-tmdb-token",
        "OPEN_LIBRARY_BASE_URL": "http://localhost:8787/api/test/openlibrary",
        "OPEN_LIBRARY_CONTACT": "operator@tastetrack.invalid",
        "IGDB_BASE_URL": "http://localhost:8787/api/test/igdb/v4",
        "TWITCH_TOKEN_URL": "http://localhost:8787/api/test/igdb/oauth2/token",
        "TWITCH_CLIENT_ID": "fake-twitch-client-id",
        "TWITCH_CLIENT_SECRET": "fake-twitch-client-secret",
        "MUSICBRAINZ_BASE_URL": "http://localhost:8787/api/test/musicbrainz/ws/2",
        "COVER_ART_ARCHIVE_BASE_URL": "http://localhost:8787/api/test/coverartarchive",
        "MUSICBRAINZ_INTERVAL_MS": "50"
      }
    },
    "staging": {
      "triggers": {
        "crons": []
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-staging",
          "database_id": "278bf6dd-95f1-48f1-a10b-3c4686ac00c0",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1",
        "TMDB_BASE_URL": "https://api.themoviedb.org/3",
        "OPEN_LIBRARY_BASE_URL": "https://openlibrary.org",
        "IGDB_BASE_URL": "https://api.igdb.com/v4",
        "TWITCH_TOKEN_URL": "https://id.twitch.tv/oauth2/token",
        "MUSICBRAINZ_BASE_URL": "https://musicbrainz.org/ws/2",
        "COVER_ART_ARCHIVE_BASE_URL": "https://coverartarchive.org"
      }
    }
  }
}
