// The top level is production: `wrangler deploy` without `--env` ships it, so
// TEST_HOOKS is absent here. Test hooks are switched on only in the `local` and
// `staging` envs below. Envs don't inherit `vars` or bindings, so each env
// repeats the bindings it needs. TMDB_BASE_URL is real TMDB everywhere except `local`, which
// searches the TMDB fake among its own test hooks with a placeholder token. TMDB_ACCESS_TOKEN is
// a secret on staging and production, set with `wrangler secret put` (see README).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tastetrack",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "TMDB_BASE_URL": "https://api.themoviedb.org/3"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tastetrack-production",
      "database_id": "dbbae3f8-e6a6-4053-afb4-2b7b327d5a93",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1",
        "TMDB_BASE_URL": "http://localhost:8787/api/test/tmdb/3",
        "TMDB_ACCESS_TOKEN": "fake-tmdb-token"
      }
    },
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-staging",
          "database_id": "278bf6dd-95f1-48f1-a10b-3c4686ac00c0",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1",
        "TMDB_BASE_URL": "https://api.themoviedb.org/3"
      }
    }
  }
}
