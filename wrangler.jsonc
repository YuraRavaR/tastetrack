// The top level is what `wrangler deploy` without `--env` ships, so it must be
// production-safe: TEST_HOOKS is absent here. Test hooks are switched on only
// in the `local` and `staging` envs below. Envs don't inherit `vars` or
// bindings, so each env repeats the bindings it needs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tastetrack",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tastetrack-local",
      "database_id": "278bf6dd-95f1-48f1-a10b-3c4686ac00c0",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "local": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-local",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1"
      }
    },
    "staging": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tastetrack-staging",
          // Placeholder: replace with the id from `wrangler d1 create tastetrack-staging`.
          // The staging deploy fails until it is a real database id.
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "vars": {
        "TEST_HOOKS": "1"
      }
    }
  }
}
