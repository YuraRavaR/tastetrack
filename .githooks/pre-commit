#!/bin/sh
# Block commits made directly on main. See "Git workflow" in AGENTS.md.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

if [ "$branch" = "main" ]; then
  echo "pre-commit: direct commits to main are not allowed." >&2
  echo "Create a branch first: git switch -c <type>/<short-slug>" >&2
  exit 1
fi
