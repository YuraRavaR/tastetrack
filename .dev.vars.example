# Copy to .dev.vars for local secrets and overrides. .dev.vars is git-ignored.
# Test hooks are on in the `local` env (see wrangler.jsonc); set to 0 to turn them off.
# TEST_HOOKS=0

# The `local` env searches a TMDB fake (see wrangler.jsonc). To search the real TMDB locally,
# set both of these; the token is TMDB's "API Read Access Token".
# TMDB_BASE_URL=https://api.themoviedb.org/3
# TMDB_ACCESS_TOKEN=

# The `local` env searches an Open Library fake too. To search the real Open Library locally, set
# both of these; the contact is an email address or URL where Open Library can reach you.
# OPEN_LIBRARY_BASE_URL=https://openlibrary.org
# OPEN_LIBRARY_CONTACT=

# The `local` env calls an IGDB fake for games and their Twitch token, and takes any credentials.
# To search the real IGDB locally, set all four; the ID and secret are your Twitch application's.
# IGDB_BASE_URL=https://api.igdb.com/v4
# TWITCH_TOKEN_URL=https://id.twitch.tv/oauth2/token
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=

# The `local` env calls a MusicBrainz fake for albums, and a Cover Art Archive fake for their
# covers, 50 ms apart. To call the real ones locally, set all three; MusicBrainz takes no key, and
# is told who is asking with OPEN_LIBRARY_CONTACT.
# MUSICBRAINZ_BASE_URL=https://musicbrainz.org/ws/2
# COVER_ART_ARCHIVE_BASE_URL=https://coverartarchive.org
# MUSICBRAINZ_INTERVAL_MS=1100
